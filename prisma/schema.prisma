generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH.JS MODELS (NextAuth v5) =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  CUSTOMER
  ADMIN
  SCHOOL
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== VANTAGE PLATFORM MODELS =====

model Book {
  id            String      @id @default(cuid())
  title         String
  author        String
  price         Float
  originalPrice Float?
  currency      String      @default("₦")
  imageUrl      String
  category      String
  level         String
  subject       String
  rating        Float       @default(0)
  reviewCount   Int         @default(0)
  description   String      @db.Text
  isbn          String      @unique
  publisher     String      @default("Vantage Academic Press")
  edition       String
  language      String      @default("English (UK Standard)")
  pageCount     Int
  inStock       Boolean     @default(true)
  formats       String[]    // Array of 'paperback', 'ebook'
  tags          String[]    // e.g., 'New Arrival', 'Sale'
  highlights    String[]    // Key features
  
  orderItems    OrderItem[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Guest checkout details
  guestEmail    String?
  guestName     String?
  
  paystackRef   String?     @unique
  totalAmount   Float
  shippingFee   Float       @default(0)
  taxAmount     Float       @default(0)
  status        OrderStatus @default(PENDING)
  
  // Delivery Address
  street        String
  city          String
  state         String
  
  items         OrderItem[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  quantity  Int      @default(1)
  format    String   // 'paperback' or 'ebook'
  priceAt   Float    // Price at the time of purchase
}
